# Fixture corpus: keep .hwp out of git unless explicitly checked in.
# Large real-world samples (e.g. TRL report ~5MB + 9 JPEG blobs) balloon
# the repo and may carry organisation-private content.
/test/*.hwp
/test/*.hwpx
/test/*.md
!/test/.gitkeep
