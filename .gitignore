/target
**/*.rs.bk
/node_modules
/pkg
/dist
/ts/dist
/ts/node_modules
# wasm-pack output — regenerate with `npm run build:wasm` in `ts/`.
/ts/src/wasm/
.DS_Store
.idea/
.vscode/
*.log

# Local AI agent session state.
/.claude/
.omc/

# Fixture corpus: keep .hwp out of git unless explicitly checked in.
# Large real-world samples (e.g. TRL report ~5MB + 9 JPEG blobs) balloon
# the repo and may carry organisation-private content.
/test/*.hwp
/test/*.hwpx
/test/*.md
!/test/.gitkeep
